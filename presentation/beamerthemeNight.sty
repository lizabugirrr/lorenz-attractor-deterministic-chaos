% =====================================================================
%  beamerthemeNight — тема «Синоптична карта»: папір, ізобари,
%  холодний (синій) і теплий (червоний) фронти
% =====================================================================
\ProvidesPackage{beamerthemeNight}[2026/11/26]
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta,fadings,decorations.pathmorphing,shapes.geometric}
\RequirePackage[most]{tcolorbox}

\definecolor{NNight}{HTML}{F4EFE2}
\definecolor{NTitle}{HTML}{F4EFE2}
\definecolor{NDeep}{HTML}{F4EFE2}
\definecolor{NCard}{HTML}{E9E1CC}
\definecolor{NLine}{HTML}{CDC4AC}
\definecolor{NInk}{HTML}{1F2A37}
\definecolor{NDim}{HTML}{55524A}
\definecolor{NGold}{HTML}{8F5B12}
\definecolor{NOrange}{HTML}{B83227}
\definecolor{NTeal}{HTML}{2F7A5B}
\definecolor{NSand}{HTML}{A8740F}
\definecolor{NSky}{HTML}{1F5C99}

\setbeamercolor{normal text}{fg=NInk,bg=NNight}
\setbeamercolor{structure}{fg=NGold}
\setbeamercolor{alerted text}{fg=NOrange}
\setbeamercolor{frametitle}{fg=NInk}
\setbeamercolor{itemize item}{fg=NOrange}
\setbeamercolor{enumerate item}{fg=NOrange}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\tikz\fill[NOrange] (0,0) circle (0.45ex);}}
\setbeamertemplate{itemize subitem}{\raisebox{0.2ex}{\tikz\fill[NTeal] (0,0) circle (0.35ex);}}
\setlength{\leftmargini}{1.3em}

% ---------- фон: папір із ледь помітними ізобарами -----------------------
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[NNight] (current page.south west) rectangle (current page.north east);
    \node[opacity=0.25,inner sep=0] at (current page.center)
      {\includegraphics[width=\paperwidth,height=\paperheight]{pop_isobars.png}};
  \end{tikzpicture}}

% ---------- заголовок із лінією атмосферного фронту ----------------------
\newcommand{\Nfront}{%
  \begin{tikzpicture}
    \draw[NSky,line width=1.1pt] (0,0) -- (1.5,0);
    \foreach \x in {0.18,0.68,1.18} \fill[NSky] (\x,0) -- ++(0.13,0.14) -- ++(0.13,-0.14) -- cycle;
    \draw[NOrange,line width=1.1pt] (1.5,0) -- (3,0);
    \foreach \x in {1.68,2.18,2.68} \fill[NOrange] (\x,0) arc (180:0:0.12) -- cycle;
  \end{tikzpicture}}
\setbeamerfont{frametitle}{size=\LARGE,series=\bfseries}
\setbeamertemplate{frametitle}{%
  \vspace*{0.6em}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=1.25em,rightskip=1.25em]{frametitle}
    {\usebeamerfont{frametitle}\insertframetitle}\\[-0.35em]
    \Nfront
  \end{beamercolorbox}%
  \vspace{-0.2em}}

% ---------- низ: тонкий прогрес + номер --------------------------------
\setbeamertemplate{footline}{%
  \hfill\tikz[baseline=(n.base)]\node[draw=NDim,circle,inner sep=1pt,minimum size=1.5em,
    font=\scriptsize,text=NDim] (n) {\insertframenumber};%
  \hspace*{1em}\par\vspace{0.6em}}

% ---------- картки ------------------------------------------------------
\tcbset{Ncard/.style={enhanced,arc=2pt,boxrule=0pt,colback=NCard,coltext=NInk,
  left=10pt,right=10pt,top=7pt,bottom=7pt,before skip=4pt,after skip=4pt,
  fonttitle=\bfseries\small,coltitle=#1,title filled=false,colbacktitle=NCard,
  halign=flush left,
  toptitle=1pt,bottomtitle=-2pt}}
\newtcolorbox{card}[2][NGold]{Ncard=#1,title={#2}}
\newtcolorbox{plaincard}[1][NGold]{Ncard=#1}

% формула-«зірка»
\newtcolorbox{bigeq}[1][NOrange]{enhanced,arc=2pt,boxrule=0pt,colback=NCard,
  coltext=NInk,halign=flush center,left=8pt,right=8pt,top=4pt,bottom=4pt,
  before skip=6pt,after skip=6pt}

% велике число + підпис
\newcommand{\stat}[3][NGold]{%
  \begin{minipage}[t]{\linewidth}\centering
    {\fontsize{22}{24}\selectfont\bfseries\color{#1}#2}\\[0.1em]
    {\footnotesize\color{NDim}#3}
  \end{minipage}}

\newcommand{\hl}[1]{\textcolor{NOrange}{\bfseries #1}}
\newcommand{\gl}[1]{\textcolor{NGold}{\bfseries #1}}
\newcommand{\tl}[1]{\textcolor{NTeal}{\bfseries #1}}
\newcommand{\dimtxt}[1]{\textcolor{NDim}{#1}}
\newcommand{\bigquote}[2]{%
  {\Large\itshape\color{NInk}«#1»}\\[0.5em]{\normalsize\color{NGold}— #2}}

\endinput
