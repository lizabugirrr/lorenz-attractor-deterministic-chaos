% =====================================================================
%  beamerthemeNight — науково-популярна тема «Нічне небо»
%  темний фон, великий шрифт, світні акценти траєкторій
% =====================================================================
\ProvidesPackage{beamerthemeNight}[2026/11/26]
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta,fadings,decorations.pathmorphing,shapes.geometric}
\RequirePackage[most]{tcolorbox}

\definecolor{NNight}{HTML}{070B1A}
\definecolor{NTitle}{HTML}{0B132B}
\definecolor{NDeep}{HTML}{0E1630}
\definecolor{NCard}{HTML}{18223F}
\definecolor{NLine}{HTML}{2C3757}
\definecolor{NInk}{HTML}{E8E6E3}
\definecolor{NDim}{HTML}{9AA5BD}
\definecolor{NGold}{HTML}{F4A261}
\definecolor{NOrange}{HTML}{E76F51}
\definecolor{NTeal}{HTML}{2A9D8F}
\definecolor{NSand}{HTML}{E9C46A}
\definecolor{NSky}{HTML}{6FB3D9}

\setbeamercolor{normal text}{fg=NInk,bg=NNight}
\setbeamercolor{structure}{fg=NGold}
\setbeamercolor{alerted text}{fg=NOrange}
\setbeamercolor{frametitle}{fg=white}
\setbeamercolor{itemize item}{fg=NOrange}
\setbeamercolor{enumerate item}{fg=NOrange}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\tikz\fill[NOrange] (0,0) circle (0.45ex);}}
\setbeamertemplate{itemize subitem}{\raisebox{0.2ex}{\tikz\fill[NTeal] (0,0) circle (0.35ex);}}
\setlength{\leftmargini}{1.3em}

% ---------- фон: нічний градієнт + ледь помітне «сяйво» ----------------
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[top color=NDeep,bottom color=NNight]
      (current page.south west) rectangle (current page.north east);
    \fill[NSky,opacity=0.05] ($(current page.north east)+(-1.2,-0.6)$) circle (3.2cm);
    \fill[NOrange,opacity=0.035] ($(current page.south west)+(1.5,0.8)$) circle (2.6cm);
  \end{tikzpicture}}

% ---------- заголовок: «кікер» (номер розділу) + великий заголовок -----
\setbeamerfont{frametitle}{size=\LARGE,series=\bfseries}
\setbeamertemplate{frametitle}{%
  \vspace*{0.35em}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=1.25em,rightskip=1.25em]{frametitle}
    \ifx\insertframesubtitle\@empty\else
      {\footnotesize\color{NGold}\bfseries\addfontfeature{LetterSpace=12}\MakeUppercase{\insertframesubtitle}}\\[0.15em]%
    \fi
    {\usebeamerfont{frametitle}\insertframetitle}\\[-0.6em]
    \tikz{\fill[NOrange] (0,0) rectangle (1.1,0.055);\fill[NGold] (1.1,0) rectangle (1.6,0.055);\fill[NTeal] (1.6,0) rectangle (1.85,0.055);}
  \end{beamercolorbox}%
  \vspace{-0.3em}}

% ---------- низ: тонкий прогрес + номер --------------------------------
\newlength{\Nprogress}
\setbeamertemplate{footline}{%
  \ifnum\inserttotalframenumber>1
    \setlength{\Nprogress}{\dimexpr\paperwidth*\insertframenumber/\inserttotalframenumber\relax}
  \else\setlength{\Nprogress}{0pt}\fi
  \hfill{\scriptsize\color{NDim}\insertframenumber\,/\,\inserttotalframenumber}\hspace*{1.2em}\par\vspace{0.35em}
  \begin{tikzpicture}
    \fill[NLine] (0,0) rectangle (\paperwidth,0.04);
    \shade[left color=NOrange,right color=NGold] (0,0) rectangle (\Nprogress,0.04);
  \end{tikzpicture}}

% ---------- картки ------------------------------------------------------
\tcbset{Ncard/.style={enhanced,arc=4pt,boxrule=0pt,colback=NCard,coltext=NInk,
  left=7pt,right=7pt,top=5pt,bottom=5pt,before skip=4pt,after skip=4pt,
  fonttitle=\bfseries\small,coltitle=#1,title filled=false,colbacktitle=NCard,
  borderline west={2.5pt}{0pt}{#1},halign=flush left,
  toptitle=1pt,bottomtitle=-2pt}}
\newtcolorbox{card}[2][NGold]{Ncard=#1,title={#2}}
\newtcolorbox{plaincard}[1][NGold]{Ncard=#1}

% формула-«зірка»
\newtcolorbox{bigeq}[1][NOrange]{enhanced,arc=6pt,boxrule=0.7pt,colframe=#1,colback=NCard,
  coltext=white,halign=flush center,left=8pt,right=8pt,top=2pt,bottom=2pt,
  before skip=6pt,after skip=6pt,
  borderline={0.4pt}{1.5pt}{#1!35!NCard}}

% велике число + підпис
\newcommand{\stat}[3][NGold]{%
  \begin{minipage}[t]{\linewidth}\centering
    {\fontsize{22}{24}\selectfont\bfseries\color{#1}#2}\\[0.1em]
    {\footnotesize\color{NDim}#3}
  \end{minipage}}

\newcommand{\hl}[1]{\textcolor{NOrange}{\bfseries #1}}
\newcommand{\gl}[1]{\textcolor{NGold}{\bfseries #1}}
\newcommand{\tl}[1]{\textcolor{NTeal}{\bfseries #1}}
\newcommand{\dimtxt}[1]{\textcolor{NDim}{#1}}
\newcommand{\bigquote}[2]{%
  {\Large\itshape\color{white}«#1»}\\[0.5em]{\normalsize\color{NGold}— #2}}

\endinput
